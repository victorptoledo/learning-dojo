# {{name}}: {{slo}}% of requests succeed (are not 5xx) over 30 days, so the error budget
# is {{budget}} of the requests. Generated by the golden path: change the tier, not this file.
groups:
  - name: {{name}}-slo
    rules:
      - record: job:slo_errors_per_request:ratio_rate5m
        expr: |
          sum by (job) (rate(http_requests_total{job="{{name}}", code=~"5.."}[5m]))
            /
          sum by (job) (rate(http_requests_total{job="{{name}}"}[5m]))
      - record: job:slo_errors_per_request:ratio_rate30m
        expr: |
          sum by (job) (rate(http_requests_total{job="{{name}}", code=~"5.."}[30m]))
            /
          sum by (job) (rate(http_requests_total{job="{{name}}"}[30m]))
      - record: job:slo_errors_per_request:ratio_rate1h
        expr: |
          sum by (job) (rate(http_requests_total{job="{{name}}", code=~"5.."}[1h]))
            /
          sum by (job) (rate(http_requests_total{job="{{name}}"}[1h]))
      - record: job:slo_errors_per_request:ratio_rate6h
        expr: |
          sum by (job) (rate(http_requests_total{job="{{name}}", code=~"5.."}[6h]))
            /
          sum by (job) (rate(http_requests_total{job="{{name}}"}[6h]))
      - alert: ErrorBudgetBurnFast
        expr: |
          job:slo_errors_per_request:ratio_rate1h{job="{{name}}"} > (14.4 * {{budget}})
            and
          job:slo_errors_per_request:ratio_rate5m{job="{{name}}"} > (14.4 * {{budget}})
        for: 2m
        labels:
          severity: page
          service: {{name}}
          team: {{team}}
          slo: {{name}}-availability
        annotations:
          summary: {{name}} is burning its error budget fast
          runbook_url: https://runbooks.example.com/{{name}}
      - alert: ErrorBudgetBurnSlow
        expr: |
          job:slo_errors_per_request:ratio_rate6h{job="{{name}}"} > (6 * {{budget}})
            and
          job:slo_errors_per_request:ratio_rate30m{job="{{name}}"} > (6 * {{budget}})
        for: 15m
        labels:
          severity: ticket
          service: {{name}}
          team: {{team}}
          slo: {{name}}-availability
        annotations:
          summary: {{name}} is burning its error budget
          runbook_url: https://runbooks.example.com/{{name}}
