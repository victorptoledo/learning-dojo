{
  "uid": "slo-search",
  "title": "search SLOs",
  "tags": [
    "slo",
    "generated"
  ],
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "availability: SLI over 28d",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "SLI",
          "expr": "1 - slo:sli_error:ratio_rate28d{service=\"search\",slo=\"availability\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "availability: error budget left",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "budget left",
          "expr": "1 - slo:sli_error:ratio_rate28d{service=\"search\",slo=\"availability\"} / slo:error_budget:ratio{service=\"search\",slo=\"availability\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "availability: burn rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "1h",
          "expr": "slo:sli_error:ratio_rate1h{service=\"search\",slo=\"availability\"} / slo:error_budget:ratio{service=\"search\",slo=\"availability\"}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "6h",
          "expr": "slo:sli_error:ratio_rate6h{service=\"search\",slo=\"availability\"} / slo:error_budget:ratio{service=\"search\",slo=\"availability\"}"
        }
      ]
    }
  ]
}
