{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BuildApps",
      "Effect": "Allow",
      "Action": ["s3:*", "dynamodb:*", "sqs:*", "lambda:*", "logs:*", "cloudwatch:*"],
      "Resource": "*"
    },
    {
      "Sid": "TodoOnlyAppRolesWithTheBoundary",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": "*"
    }
  ]
}
