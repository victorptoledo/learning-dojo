# The company's rules for production stacks, checked before every deployment:
#   cfn-guard validate --rules rules/company.guard --data app.yaml

let launch_templates = Resources.*[ Type == 'AWS::EC2::LaunchTemplate' ]
let databases = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
let keys = Resources.*[ Type == 'AWS::KMS::Key' ]
let listeners = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::Listener' ]
let roles = Resources.*[ Type == 'AWS::IAM::Role' ]

rule imdsv2_only when %launch_templates !empty {
    %launch_templates.Properties.LaunchTemplateData.MetadataOptions.HttpTokens == 'required'
    <<Instances answer only IMDSv2: MetadataOptions.HttpTokens is required>>
}

rule encrypted_volumes when %launch_templates !empty {
    %launch_templates.Properties.LaunchTemplateData.BlockDeviceMappings[ Ebs exists ] {
        Ebs.Encrypted == true
        <<Every EBS volume of a launch template is encrypted>>
    }
}

rule resilient_databases when %databases !empty {
    %databases.Properties {
        MultiAZ == true
        <<Databases run Multi-AZ>>
        BackupRetentionPeriod >= 7
        <<Databases keep backups at least 7 days>>
        DeletionProtection == true
        <<Databases have deletion protection>>
        StorageEncrypted == true
        KmsKeyId exists
        <<Databases are encrypted with a customer managed key (KmsKeyId)>>
    }
}

rule no_database_passwords when %databases !empty {
    %databases.Properties {
        MasterUserPassword not exists
        ManageMasterUserPassword == true
        <<RDS manages the master password in Secrets Manager; no password in the template>>
    }
}

rule rotating_keys when %keys !empty {
    %keys.Properties.EnableKeyRotation == true
    <<Customer managed keys rotate every year>>
}

rule https_only_listeners when %listeners !empty {
    let https = %listeners[ Properties.Protocol == 'HTTPS' ]
    let http = %listeners[ Properties.Protocol == 'HTTP' ]
    when %https !empty {
        %https.Properties.SslPolicy == /^ELBSecurityPolicy-TLS13-/
        <<HTTPS listeners use a TLS 1.3 security policy>>
    }
    when %http !empty {
        %http.Properties.DefaultActions[*] {
            Type == 'redirect'
            RedirectConfig.Protocol == 'HTTPS'
            <<HTTP listeners only redirect to HTTPS>>
        }
    }
}

rule scoped_role_policies when %roles !empty {
    %roles.Properties.Policies[*].PolicyDocument.Statement[ Effect == 'Allow' ] {
        Action[*] != /\*/
        <<Inline policies name their actions: no * in an Action>>
        when Resource is_string {
            Resource != '*'
            <<Inline policies name their resources: no Resource *>>
        }
        when Resource is_list {
            Resource[ this == '*' ] empty
            <<Inline policies name their resources: no Resource *>>
        }
    }
}
