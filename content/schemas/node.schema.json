{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-dojo.local/schemas/node.schema.json",
  "title": "Node manifest (node.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "status",
    "title",
    "summary",
    "objectives",
    "prerequisites",
    "difficulty",
    "estimated_minutes",
    "xp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.p[0-9]\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "legacy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "lesson",
        "kata",
        "quiz",
        "checkpoint",
        "project"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "skills"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "xp": {
      "type": "integer",
      "minimum": 0
    },
    "lesson": {
      "type": "string",
      "pattern": "\\.md$"
    },
    "bridges": {
      "type": "string"
    },
    "kata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "starter",
        "tests",
        "reference",
        "runner"
      ],
      "description": "Kata layout, relative to the node folder. `tests` holds the grading tests, never copied to the learner's workspace.",
      "properties": {
        "statement": {
          "type": "string",
          "pattern": "\\.md$"
        },
        "starter": {
          "type": "string"
        },
        "tests": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "samples": {
          "type": "string"
        },
        "rubric": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "maxItems": 3,
          "description": "Hint ladder, opened one at a time; each costs 10% of the kata XP: (1) a question that points the way, (2) the concept and where it applies, (3) a partial skeleton without the solution.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "timeout_secs"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^dojo-[a-z0-9-]+$"
            },
            "timeout_secs": {
              "type": "integer",
              "minimum": 5,
              "maximum": 600
            }
          }
        }
      }
    },
    "mastery": {
      "type": "object"
    },
    "remedial": {
      "type": "array",
      "description": "Practice katas on the same skills, opened on request with F. They give practice XP and never count towards completion. Lay each one out under `remedial/<id>/`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "skills",
          "kata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "kata": {
            "$ref": "#/properties/kata"
          }
        }
      }
    },
    "closes_phase": {
      "type": "string",
      "pattern": "^p[0-9]$"
    },
    "covers_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills the checkpoint reviews."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pass_rule": {
      "enum": [
        "all_sections",
        "any_section"
      ]
    },
    "on_fail": {
      "type": "object"
    },
    "acts_as_belt_exam": {
      "type": "boolean"
    },
    "quiz": {
      "type": "string",
      "pattern": "\\.yaml$",
      "description": "Quiz file (quiz.yaml) that completes this lesson."
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "criteria"],
      "description": "An open written exercise. The learner answers in ANSWER.md and the dojo builds a review prompt for an AI of their choice. Feedback only: it never gates progress.",
      "properties": {
        "task": { "type": "string", "minLength": 20 },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "why"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tool",
              "vscode-extension",
              "docker-engine",
              "docker-image"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "description": "Defaults to true."
          },
          "command": {
            "type": "string"
          },
          "version_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_version": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)*$"
          },
          "install_hint": {
            "type": "string"
          },
          "update": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "image": {
            "type": "string",
            "pattern": "^dojo-[a-z0-9-]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "install_hint"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "vscode-extension"
                }
              }
            },
            "then": {
              "required": [
                "id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "docker-engine"
                }
              }
            },
            "then": {
              "required": [
                "install_hint"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "docker-image"
                }
              }
            },
            "then": {
              "required": [
                "image"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "checkpoint"
          }
        }
      },
      "then": {
        "required": [
          "closes_phase",
          "quiz",
          "kata"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "kata"
          }
        }
      },
      "then": {
        "required": [
          "kata"
        ]
      }
    }
  ]
}
