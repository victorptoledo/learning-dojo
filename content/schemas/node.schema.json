{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-dojo.local/schemas/node.schema.json",
  "title": "Node manifest (node.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "status", "title", "summary", "objectives", "prerequisites", "difficulty", "estimated_minutes", "xp"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.p[0-4]\\.[a-z0-9]+(-[a-z0-9]+)*$" },
    "legacy_id": { "type": ["string", "null"] },
    "kind": { "enum": ["lesson", "kata", "quiz", "checkpoint", "project"] },
    "status": { "enum": ["draft", "reviewed"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "skills"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "skills": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "xp": { "type": "integer", "minimum": 0 },
    "lesson": { "type": "string", "pattern": "\\.md$" },
    "bridges": { "type": "string" },
    "kata": { "type": "object", "description": "Kata layout and runner settings; schema tightened when the runner lands (M2)." },
    "mastery": { "type": "object" },
    "remedial": { "type": "array", "items": { "type": "string" } },
    "closes_phase": { "type": "string", "pattern": "^p[0-4]$" },
    "covers_skills": { "type": "array", "items": { "type": "string" } },
    "sections": { "type": "array", "items": { "type": "object" } },
    "pass_rule": { "enum": ["all_sections", "any_section"] },
    "on_fail": { "type": "object" },
    "acts_as_belt_exam": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "checkpoint" } } },
      "then": { "required": ["closes_phase", "covers_skills", "sections"] }
    }
  ]
}
