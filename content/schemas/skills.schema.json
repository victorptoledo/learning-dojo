{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-dojo.local/schemas/skills.schema.json",
  "title": "Skill taxonomy file (skills/<namespace>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "skills"],
  "properties": {
    "namespace": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
          "title": { "type": "string", "minLength": 1 },
          "maps_to": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
