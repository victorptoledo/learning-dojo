{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-dojo.local/schemas/track.schema.json",
  "title": "Track manifest (track.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "archetype",
    "category",
    "icon",
    "description",
    "status",
    "belts",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "enum": [
        "language",
        "platform",
        "concept",
        "role"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        },
        "file_ext": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_runner": {
          "type": "string"
        }
      }
    },
    "bridges_available": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "feeds_careers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "belts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required_xp",
          "title"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required_xp": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dir",
          "title",
          "goal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p[0-4]$"
          },
          "dir": {
            "type": "string",
            "pattern": "^p[0-4]-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "why"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tool",
              "vscode-extension",
              "docker-engine",
              "docker-image"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "description": "Defaults to true."
          },
          "command": {
            "type": "string"
          },
          "version_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_version": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)*$"
          },
          "install_hint": {
            "type": "string"
          },
          "update": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "image": {
            "type": "string",
            "pattern": "^dojo-[a-z0-9-]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "install_hint"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "vscode-extension"
                }
              }
            },
            "then": {
              "required": [
                "id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "docker-engine"
                }
              }
            },
            "then": {
              "required": [
                "install_hint"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "docker-image"
                }
              }
            },
            "then": {
              "required": [
                "image"
              ]
            }
          }
        ]
      }
    }
  }
}
