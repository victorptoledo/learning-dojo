{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-dojo.local/schemas/bridge.schema.json",
  "title": "Rosetta bridge front matter (bridges/<language>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "status", "concept", "from_way", "native_way", "sensei_tip"],
  "properties": {
    "from": { "type": "string", "pattern": "^[a-z0-9+#-]+$" },
    "status": { "enum": ["draft", "reviewed"] },
    "concept": { "type": "string", "minLength": 1 },
    "from_way": { "type": "string", "minLength": 1 },
    "native_way": { "type": "string", "minLength": 1 },
    "sensei_tip": { "type": "string", "minLength": 1 }
  }
}
