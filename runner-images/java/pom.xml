<?xml version="1.0" encoding="UTF-8"?>
<!-- Only used while building the image: downloads the libraries katas may use into
     /opt/dojo/lib-<set>, one folder per set. Checks run offline and never call Maven; the
     check picks a set from the kata's own pom.xml (see check.sh), because Spring Boot
     auto-configures whatever is on the classpath (Security, for one, locks every endpoint).

     Sets, each one including the previous:
       base      JUnit only (plain Java katas)          no profile
       web       Spring MVC, validation, MockMvc        -Pweb
       data      + Spring Data JPA and H2               -Pweb,data
       security  + Spring Security                      -Pweb,data,security
       full      + Actuator, cache, RestClient          -Pweb,data,security,extras

     Versions come from the Spring Boot BOM (JUnit 6, Spring Framework 7, Jackson 3, Hibernate 7). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dojo</groupId>
    <artifactId>runner-libraries</artifactId>
    <version>3</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.2</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <!-- ConsoleLauncher: the check runs it with -cp; it brings the launcher and the XML reports -->
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-console</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>web</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-webmvc</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-validation</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-test</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-webmvc-test</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>data</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-jpa</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-jpa-test</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>security</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-security</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-security-test</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>extras</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-actuator</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-cache</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-restclient</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-restclient-test</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
